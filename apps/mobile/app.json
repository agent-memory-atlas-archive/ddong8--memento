{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.64",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihasy.memento.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Memento 需要读取您的健康睡眠与作息数据，以便全自动同步精力与生活节律分析。",
        "NSHealthUpdateUsageDescription": "Memento 需要访问您的健康数据以保持作息同步。"
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ihasy.memento.mobile",
      "permissions": ["android.permission.PACKAGE_USAGE_STATS"]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withHealthKit.js",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F5FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B12"
          }
        }
      ]
    ],
    "scheme": "memento",
    "experiments": {
      "typedRoutes": true
    }
  }
}
